# Google AI Studio / Gemini API key
GOOGLE_API_KEY=your_gemini_api_key_here

# Set true to run without a Gemini key using built-in demo responses.
DEMO_MODE=false

# Models. Current defaults are selected for the live Gemini API.
WORKOUT_MODEL=gemini-3.8-flash
TIP_MODEL=gemini-3.5-flash-lite

# SQLite database file
DATABASE_URL=sqlite:///./fitbuddy.db

# Protects /view-all-users and /api/users
ADMIN_TOKEN=change-this-token
